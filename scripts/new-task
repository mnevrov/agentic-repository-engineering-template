#!/usr/bin/env python3
from pathlib import Path
import sys

if len(sys.argv) < 3:
    print('usage: scripts/new-task TASK-ID "Title"', file=sys.stderr)
    raise SystemExit(2)

task_id = sys.argv[1].strip()
title = ' '.join(sys.argv[2:]).strip()
if not task_id or '/' in task_id or '..' in task_id:
    print('invalid task id', file=sys.stderr)
    raise SystemExit(2)

root = Path(__file__).resolve().parents[1]
template = (root / '.ai/templates/TASK.md').read_text(encoding='utf-8')
out = root / 'docs/tasks' / f'{task_id}.md'
if out.exists():
    print(f'already exists: {out}', file=sys.stderr)
    raise SystemExit(1)

content = template.replace('TASK-XXX — Название', f'{task_id} — {title}', 1)
out.write_text(content, encoding='utf-8')
print(out.relative_to(root))
